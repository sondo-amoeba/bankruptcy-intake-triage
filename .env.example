# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Vercel Postgres sets POSTGRES_URL automatically when Storage is linked.
# DATABASE_URL also works (e.g. Neon CLI or manual env).
POSTGRES_URL=
# DATABASE_URL=

# Set to true to demo export retry (first attempt fails, retry succeeds)
# EXPORT_SIMULATE_FAILURE=true
